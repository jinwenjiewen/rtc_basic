# 保留已有云端配置；全部替换为你自己的值。
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
RTC_APP_ID=
RTC_APP_KEY=
# 控制台临时 Token 单独填写在这里（仅用于单人联调）。留空时用 AppKey 动态签发。
RTC_STATIC_TOKEN=
# 使用临时 Token 时，留空会从 Token 中读取其绑定的 RoomId / UserId。
RTC_ROOM_ID=
RTC_USER_ID=
RTC_TASK_ID=ChatTask01
ARK_ENDPOINT_ID=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SERVER_URL=https://your-public-domain.example.com

# 数据库密码请填写在本机 .env 中；建议生产环境使用专用数据库用户。
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/rtc_basic
# 用 uv run python -c "import secrets; print(secrets.token_urlsafe(48))" 分别生成两个随机密钥。
JWT_SECRET_KEY=
RTC_CALLBACK_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# 生产环境 HTTPS 必须设为 true。localhost HTTP 开发用 false。
AUTH_COOKIE_SECURE=false
# 精确填写所有前端 Origin（协议、主机和端口）；不支持 *。
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 仅空用户表时创建首次账号。修改这里不会覆盖已存在账号的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

INTENTION_API_KEY=
INTENTION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
INTENTION_MODEL=doubao-seed-2-0-mini-260428
INTENTION_TIMEOUT=5
INTENTION_ENABLED=true
KNOWLEDGE_BASE_API_KEY=
