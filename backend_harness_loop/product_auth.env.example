# Reuse the existing account database; product does not create/migrate users.
# Credentials remain in an ignored local file selected with --auth-env-file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# false is for loopback HTTP; configure true and explicit HTTPS origins at deployment.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3101,http://127.0.0.1:3101,http://localhost:3000,http://127.0.0.1:3000
