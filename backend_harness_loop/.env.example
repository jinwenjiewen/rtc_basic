# Independent Harness development configuration; select with --env-file.
# Product configuration templates: product_auth.env.example and product_rtc.env.example.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_ENDPOINT_ID=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
RTC_APP_ID=
RTC_APP_KEY=
# Optional RTC overrides for explicit development probes:
M0_RTC_APP_ID=
M0_RTC_APP_KEY=
# Optional explicit room-bound console Token for M0 browser validation only:
M0_RTC_STATIC_TOKEN=
M0_RTC_STATIC_ROOM_ID=
M0_RTC_STATIC_USER_ID=
RTC_CALLBACK_SECRET=
SERVER_URL=
M0_RTC_API_VERSION=2024-12-01
# This voice is used only by the explicit 2025 public-resource profile.
M0_RTC_TTS_VOICE=zh_female_vv_uranus_bigtts
M0_RTC_TEXT_PROBE=false
M0_RTC_INTERRUPT_ONLY=false
M0_RTC_PROBE_HOLD_SECONDS=3
M0_MODEL_TIMEOUT_SECONDS=15
M0_MODEL_THINKING=disabled
M0_FIRST_OUTPUT_DEADLINE_MS=6000
M0_CAPTURE_FAIL_FIRST=false
M0_CAPTURE_DELAY_MS=0
M0_CAPTURE_CHUNKS=1
# Disable ambient proxies by default; --trust-env explicitly opts into them.

# M1 model credentials only. Endpoints and model IDs are separate in model_profiles.json.
DEEPSEEK_PRO_API_KEY=
DEEPSEEK_FLASH_API_KEY=
M1_MAX_MODEL_STEPS=4
M1_MAX_TOOL_CALLS=8
M1_TURN_WALL_SECONDS=30
M1_FIRST_OUTPUT_DEADLINE_MS=9000

# M2 context budgets are service limits, not a declaration of provider capacity.
# Conservative serialized UTF-8 estimation includes messages and tool schemas.
M2_CONTEXT_INPUT_TOKENS=24576
M2_CONTEXT_WINDOW_TOKENS=32768
M2_CONTEXT_OUTPUT_RESERVE_TOKENS=1024
M2_CONTEXT_SAFETY_TOKENS=512
M2_CONTEXT_KEEP_RECENT_TURNS=4
M2_CONTEXT_WARN_RATIO=0.70
M2_CONTEXT_AUTO_RATIO=0.85
M2_CONTEXT_TARGET_RATIO=0.50
M2_CONTEXT_BACKGROUND=true
M2_CONTEXT_BACKGROUND_SECONDS=5
M2_CONTEXT_BACKGROUND_TOKENS=1500
